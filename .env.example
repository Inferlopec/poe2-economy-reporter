# Required for live delivery. Replace with the complete real Gryt webhook URL.
GRYT_WEBHOOK_URL=https://your-gryt-server.example/api/webhooks/WEBHOOK_ID/TOKEN
# Applies when YAML does not explicitly set timezone.
TZ=Europe/Riga

# Optional: a separate webhook pointing to a TEST channel, used only by send-test --demo.
# GRYT_TEST_WEBHOOK_URL=https://your-gryt-server.example/api/webhooks/TEST_WEBHOOK_ID/TEST_TOKEN
